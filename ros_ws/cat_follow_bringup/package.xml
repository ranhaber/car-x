<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>cat_follow_bringup</name>
  <version>1.0.0</version>
  <description>
    Bringup for the PiCar-X / ROCK 4D autonomous yard navigator: C1 lidar,
    TF/URDF, slam_toolbox mapping and localization, and Nav2 composed
    navigation, bridged into the cat_follow DecisionEngine.
  </description>
  <maintainer email="picarx@example.com">car-x</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>sllidar_ros2</exec_depend>
  <exec_depend>rf2o_laser_odometry</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <!-- map_saver_cli, used to save the yard map after a mapping session. -->
  <exec_depend>nav2_map_server</exec_depend>
  <!-- Manual teleop used to drive the survey during mapping.launch.py. -->
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
