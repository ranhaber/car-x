[Unit]
Description=Cat Follow control runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=picarx
Group=picarx
SupplementaryGroups=i2c gpio video
WorkingDirectory=/opt/car-x
EnvironmentFile=/etc/car-x/car-x.env
# The ultrasonic ECHO worker is pinned to one A53 core and requests SCHED_FIFO
# when CAT_FOLLOW_ULTRASONIC_REQUIRE_REALTIME=1. Production currently uses
# REQUIRE_REALTIME=0 (affinity-only). Keep configured priority below LimitRTPRIO.
AmbientCapabilities=CAP_SYS_NICE
CapabilityBoundingSet=CAP_SYS_NICE
LimitRTPRIO=80
ExecStartPre=-/usr/bin/v4l2-ctl -d ${CAT_FOLLOW_CAMERA_SENSOR_DEVICE} --set-ctrl=exposure=${CAT_FOLLOW_CAMERA_EXPOSURE},analogue_gain=${CAT_FOLLOW_CAMERA_ANALOGUE_GAIN}
# Fail fast (clear journal message) when the RKNN model has not been provisioned.
# Path is relative to WorkingDirectory (/opt/car-x). Build YOLOv8n with
# scripts/convert_yolo_to_rknn.py (rk3576) and copy to /opt/car-x/models/.
ExecStartPre=/bin/sh -c 'test -f "${CAT_FOLLOW_PERCEPTION_RKNN_MODEL_PATH}" || { echo "RKNN model missing: ${CAT_FOLLOW_PERCEPTION_RKNN_MODEL_PATH}"; exit 1; }'
ExecStart=/opt/car-x/venv/bin/python -m cat_follow.runtime.app --picarx --with-prototype-perception
# Optional monitoring UI (non-authoritative). Uncomment to enable:
# ExecStart=/opt/car-x/venv/bin/python -m cat_follow.runtime.app --picarx --with-prototype-perception --web-ui --web-ui-port 5000
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
