ROBOT_HAT_GPIO_BACKEND=rock4d
ROBOT_HAT_I2C_BUS=8

# ROCK 4D Radxa Camera 4K (IMX415) through the RKISP main path.
CAT_FOLLOW_CAMERA_DEVICE=/dev/video11
CAT_FOLLOW_CAMERA_WIDTH=640
CAT_FOLLOW_CAMERA_HEIGHT=480
CAT_FOLLOW_CAMERA_PIXEL_FORMAT=NV12
CAT_FOLLOW_CAMERA_BACKEND=v4l2
CAT_FOLLOW_CAMERA_CAPTURE_BACKEND=opencv
CAT_FOLLOW_CAMERA_FPS=30

# Validated manual controls used until Rockchip 3A tuning is integrated.
CAT_FOLLOW_CAMERA_SENSOR_DEVICE=/dev/v4l-subdev2
CAT_FOLLOW_CAMERA_EXPOSURE=2242
CAT_FOLLOW_CAMERA_ANALOGUE_GAIN=160

# Perception processing (resource optimization).  Detection runs exclusively
# on the RK3576 NPU via RKNN (no software fallback). Motion gating keeps the
# detector idle until movement.
CAT_FOLLOW_PERCEPTION_MOTION_GATING=1
CAT_FOLLOW_PERCEPTION_MOTION_SCALE=0.35
CAT_FOLLOW_PERCEPTION_MOTION_THRESHOLD=25
CAT_FOLLOW_PERCEPTION_MOTION_MIN_AREA=500
CAT_FOLLOW_PERCEPTION_DETECT_FPS=30
CAT_FOLLOW_PERCEPTION_DETECT_INTERVAL_TRACKING=1
CAT_FOLLOW_PERCEPTION_SCORE_THRESHOLD=0.5
CAT_FOLLOW_PERCEPTION_IDLE_UNLOAD_SEC=10
# Validate at startup, then unload. An accepted START_CHASE requests load/warmup
# on the detector thread so the first chase detection avoids initialization.
CAT_FOLLOW_PERCEPTION_WARMUP_ON_START=0

# Production safety.  ALLOW_STUB must stay 0 on the robot: with the NPU runtime
# absent the app hard-fails instead of quietly running the fake-detection stub
# (set to 1 only on dev laptops / CI without an NPU).  MAX_INFER_FAILURES is the
# number of consecutive NPU inference/reload failures after which the detector
# escalates and stops the app (systemd then restarts it) rather than returning
# empty detections forever.
CAT_FOLLOW_PERCEPTION_ALLOW_STUB=0
CAT_FOLLOW_PERCEPTION_MAX_INFER_FAILURES=15

# Adaptive OpenCV parallelism and CPU affinity. A53 cores 0-3 only:
# camera on 0,1; detector/tracker on 2; ultrasonic edge reader on 3.
# Leave A72 4-7 for ROS/Nav2/control.
CAT_FOLLOW_PERCEPTION_OPENCV_THREADS_IDLE=1
CAT_FOLLOW_PERCEPTION_OPENCV_THREADS_ACTIVE=4
CAT_FOLLOW_PERCEPTION_AFFINITY_ENABLED=1
CAT_FOLLOW_PERCEPTION_CAMERA_CORES=0,1
CAT_FOLLOW_PERCEPTION_DETECTOR_CORES=2

# Zero-copy fd→RGA→RKNN path (Option B). When set to dmabuf there is no
# automatic fall back to NumPy/RKNNLite for detection: init/infer failure is
# fatal. H.264 clients still trigger an on-demand CPU NV12 pack for streaming
# only (not used by the detector). Live inject requires ZEROCOPY=numpy.
CAT_FOLLOW_PERCEPTION_ZEROCOPY=dmabuf

# (9-tensor model-zoo head), built for rk3576.
# Missing model on the board is a hard error.
CAT_FOLLOW_PERCEPTION_RKNN_MODEL_PATH=models/yolov8n_coco_320_rk3576_int8.rknn
# Must match the converted model input geometry and layout (nv12 or rgb).
CAT_FOLLOW_PERCEPTION_RKNN_INPUT=320,320
CAT_FOLLOW_PERCEPTION_RKNN_INPUT_FORMAT=rgb
# Animal mode: at range the stock nano reads a cat as dog/sheep/cow/etc. Collapse
# those confusable quadrupeds (YOLO 0-idx 15,16,17,18,19,21) to the cat class so
# a cat-sized animal still counts as a cat. Trade-off: a real dog is also "Cat".
CAT_FOLLOW_PERCEPTION_ANIMAL_MODE=1

# End-to-end developer test: blend a moving real-cat cutout into every live
# camera frame before motion gating/RKNN/tracking. Keep disabled in production;
# it can be toggled at runtime through POST /api/dev/inject_cat. This feature
# injects pixels only and has no synthetic detection fallback.
CAT_FOLLOW_PERCEPTION_INJECT_CAT_ENABLED=0
CAT_FOLLOW_PERCEPTION_INJECT_CAT_IMAGE=models/cat_1_320.png
CAT_FOLLOW_PERCEPTION_INJECT_CAT_SPEED_PX_S=60

# Optional RKISP self-path lores stream for hardware-scaled motion detection.
# Set CAT_FOLLOW_CAMERA_LORES_DEVICE=/dev/video12 to enable (empty = disabled).
CAT_FOLLOW_CAMERA_LORES_DEVICE=
CAT_FOLLOW_CAMERA_LORES_WIDTH=320
CAT_FOLLOW_CAMERA_LORES_HEIGHT=240
CAT_FOLLOW_CAMERA_LORES_PIXEL_FORMAT=NV12

# Prefer the H.264 WebSocket stream (there is no MJPEG fallback). If the
# hardware encoder or Flask-Sock is unavailable, monitoring video is disabled
# while the core camera/detector/tracker/control runtime continues.
CAT_FOLLOW_WEB_REQUIRE_H264=1
# WebCodecs VideoDecoder requires a secure context. Prefer a real TLS cert;
# generate with scripts/board_gen_web_ui_cert.sh on the ROCK 4D.
CAT_FOLLOW_WEB_SSL_CERTFILE=/etc/car-x/web-ui.crt
CAT_FOLLOW_WEB_SSL_KEYFILE=/etc/car-x/web-ui.key
# WEB_CONTROL_TOKEN guards Flask motion/calibration/stream-resolution routes
# (header X-Control-Token preferred; query-string tokens are rejected).
# COMMS_TOKEN is required on UDP command datagrams (missing/wrong token dropped).
# Empty production tokens leave mutating web control unavailable (503) and UDP
# ingress disabled; they do not stop the core runtime.
# For explicit unauthenticated bench/dev only:
#   CAT_FOLLOW_ALLOW_UNAUTHENTICATED_CONTROL=1
# Do not commit real token values here.
CAT_FOLLOW_WEB_CONTROL_TOKEN=
CAT_FOLLOW_COMMS_TOKEN=
CAT_FOLLOW_ALLOW_UNAUTHENTICATED_CONTROL=0

# Safety thresholds (cm). Calibration UI may override obstacle_too_close_cm and
# obstacle_detected_cm at runtime via steering_limits.json.
# obstacle_too_close_cm is a floor under BRAKE_REVERSE_TRIGGER_CM below: the
# larger of the two stops motion.
CAT_FOLLOW_SAFETY_OBSTACLE_TOO_CLOSE_CM=10
CAT_FOLLOW_SAFETY_OBSTACLE_DETECTED_CM=50

# Canonical target-runtime knobs.  Slice 3 applies SENSOR_RECOVERY_* and
# BRAKE_REVERSE_* to DecisionEngine; other fields remain observational until
# their migration slices land.  SAFETY_* above still drives adapter severity.
CAT_FOLLOW_SEARCH_ENTRY_DISTANCE_CM=200
CAT_FOLLOW_SEARCH_SPEED_CAP_MPS=0.10
CAT_FOLLOW_SEARCH_LOCK_OBSERVATIONS=3
CAT_FOLLOW_SEARCH_INTERVAL_SEC=10
CAT_FOLLOW_LOCAL_TRACK_STALE_MS=350
CAT_FOLLOW_OVERHEAD_INVALID_MAX_SEC=10
CAT_FOLLOW_SENSOR_RECOVERY_SEC=2
CAT_FOLLOW_HANDOFF_WAIT_SEC=10
CAT_FOLLOW_RECORDING_POSTROLL_SEC=10
CAT_FOLLOW_RECORDING_DIR=
CAT_FOLLOW_RECORDING_SEGMENT_SEC=60
# Retained recording bytes and the free-space reserve that stops recording.
CAT_FOLLOW_RECORDING_QUOTA_BYTES=8589934592
CAT_FOLLOW_RECORDING_MIN_FREE_BYTES=1073741824
CAT_FOLLOW_NAV_MOVING_GOAL_MAX_HZ=2
CAT_FOLLOW_NAV_MOVING_GOAL_MIN_DISPLACEMENT_CM=25
CAT_FOLLOW_NAV_COMPLETION_XY_CM=20
CAT_FOLLOW_NAV_COMPLETION_YAW_RAD=0.3
CAT_FOLLOW_NAV_COMPLETION_DWELL_SEC=1
CAT_FOLLOW_BRAKE_REVERSE_TRIGGER_CM=15
CAT_FOLLOW_BRAKE_REVERSE_SETTLE_MS=100
CAT_FOLLOW_BRAKE_REVERSE_DURATION_SEC=0.5
CAT_FOLLOW_BRAKE_REVERSE_NORMALIZED=-0.30
CAT_FOLLOW_BRAKE_REVERSE_MAX_ATTEMPTS=3
CAT_FOLLOW_BRAKE_REVERSE_RESET_CM=20
CAT_FOLLOW_BRAKE_REVERSE_RESET_SEC=2
# CAT_FOLLOW_NAV_ULTRASONIC_COSTMAP=1 enables RangeSensorLayer + /ultrasonic_range.
# Disabling the layer for diagnosis must not disable ultrasonic direct safety.
CAT_FOLLOW_NAV_ULTRASONIC_COSTMAP=1
CAT_FOLLOW_THERMAL_CRITICAL_RETURN_SPEED_CAP_MPS=0.08
CAT_FOLLOW_THERMAL_CRITICAL_UNSAFE=0
CAT_FOLLOW_NAV2_BACKUP_ENABLED=0
# Deployment-calibrated/required values intentionally remain unset until
# measured/provisioned:
# CAT_FOLLOW_OVERHEAD_MIN_CONFIDENCE=
# CAT_FOLLOW_ASSOCIATION_BEARING_GATE_RAD=

# Event-driven HC-SR04 acquisition.  The dedicated worker uses kernel GPIO
# edge timestamps, runs on the last A53 core, and has the highest real-time
# priority inside the cat-follow process (the systemd ceiling is 80).
CAT_FOLLOW_ULTRASONIC_CPU_CORE=3
CAT_FOLLOW_ULTRASONIC_RT_PRIORITY=70
CAT_FOLLOW_ULTRASONIC_REQUIRE_REALTIME=0
CAT_FOLLOW_ULTRASONIC_PING_INTERVAL_S=0.060
CAT_FOLLOW_ULTRASONIC_ECHO_TIMEOUT_S=0.040
CAT_FOLLOW_ULTRASONIC_STALE_AFTER_S=0.250

# ROS 2 Jazzy + C1 lidar navigation (used when cat_follow runs with --ros-nav
# and by the ROS bringup systemd units). ROS_DOMAIN_ID isolates DDS traffic.
ROS_DISTRO=jazzy
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
CAT_FOLLOW_LIDAR_PORT=/dev/rplidar
CAT_FOLLOW_LIDAR_BAUD=460800

# Local odometry for --ros-nav.  "lidar" (default/production) expects RF2O
# (started by ros-nav / mapping bringup) to own /odom and odom->base_link.
# "bicycle" is DISABLED: the contract runtime never integrates commanded motion,
# so it would publish a frozen /odom; setting it warns and falls back to lidar.
CAT_FOLLOW_ODOM_SOURCE=lidar

# Saved slam_toolbox map basename (no extension) used for localization by
# ros-nav.service / rock4d_nav.launch.py. Produced by a mapping session
# (mapping.launch.py + map_saver / serialize_map). Localization fails fast when
# this is unset or the <basename>.posegraph / .data files are missing.  Mapping
# itself is map-free and ignores this. Example:
#   /opt/car-x/ros_ws/install/cat_follow_bringup/share/cat_follow_bringup/maps/yard_map
CAT_FOLLOW_MAP_FILE=

# Final velocity command topic the ros_bridge consumes. Nav2's velocity_smoother
# publishes the accel/decel-limited command here (default cmd_vel_smoothed).
CAT_FOLLOW_CMD_VEL_TOPIC=cmd_vel_smoothed

PYTHONPATH=/opt/car-x
PYTHONUNBUFFERED=1
